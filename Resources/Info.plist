<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleExecutable</key>
    <string>XDownloader</string>
    <key>CFBundleIdentifier</key>
    <string>com.gin.xdownloader</string>
    <key>CFBundleName</key>
    <string>X Downloader</string>
    <key>CFBundleDisplayName</key>
    <string>X Downloader</string>
    <!-- Sentinel: the real version is stamped from the git tag by build.sh /
         release.yml. If a build ever ships "0.0.0", the tag-stamping was skipped. -->
    <key>CFBundleVersion</key>
    <string>0</string>
    <key>CFBundleShortVersionString</key>
    <string>0.0.0</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <key>LSMinimumSystemVersion</key>
    <string>14.0</string>
    <key>NSPrincipalClass</key>
    <string>NSApplication</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSHumanReadableCopyright</key>
    <string>Copyright © 2025–2026</string>
    <!-- Sparkle auto-update. The feed is a CUMULATIVE appcast on GitHub Pages
         (served from the gh-pages branch), maintained by release.yml via
         scripts/build_appcast.py: every released version stays listed, so Sparkle
         always finds the true newest one regardless of release order. The update
         zips remain GitHub Release assets — only the feed lives on Pages. -->
    <key>SUFeedURL</key>
    <string>https://gin419.github.io/my-downloader/appcast.xml</string>
    <key>SUPublicEDKey</key>
    <string>ltvFx+VBM6x3wN8DpeiWN4AioCGbOap58RS3JSf/vQA=</string>
    <!-- Skip Sparkle's second-launch "check automatically?" prompt: checks are
         on by default and the Settings toggle can turn them off. -->
    <key>SUEnableAutomaticChecks</key>
    <true/>
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>com.gin.xdownloader.url</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>xdownloader</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
